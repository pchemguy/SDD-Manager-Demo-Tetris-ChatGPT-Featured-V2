{
  "name": "classic-tetris-browser",
  "version": "1.8.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "npm run check:save-validator && tsc --noEmit && tsc -p tsconfig.core.json --noEmit",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:unit": "npm run check:save-validator && tsc -p tsconfig.test.json && node scripts/test-unit.mjs",
    "build": "npm run typecheck && vite build",
    "browsers:install": "node scripts/browser-env.mjs install --only-shell chromium firefox",
    "test:environment": "node scripts/browser-env.mjs test --grep @environment",
    "test:browser": "node scripts/browser-env.mjs test --grep-invert @environment",
    "package": "python scripts/package_browser.py",
    "verify:package": "python scripts/verify_package.py",
    "test:package": "python scripts/test-package.py",
    "generate:save-validator": "node scripts/generate-save-validator.mjs",
    "check:save-validator": "node scripts/generate-save-validator.mjs --check",
    "test:desktop:policy": "node --check src/platform/electron/main.cjs && node --check src/platform/electron/asset-policy.cjs && node --test tests/desktop/host-policy.test.mjs tests/desktop/host-lifecycle.test.mjs && python tests/desktop/runtime-integrity.test.py",
    "test:desktop": "node scripts/desktop-env.mjs",
    "package:windows": "python scripts/package_windows.py",
    "verify:windows": "python scripts/verify_windows.py",
    "test:desktop:package": "python scripts/test-desktop-package.py"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "sql.js": "1.15.2"
  }
}
