{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:classic-tetris:game-save:1",
  "title": "Classic Tetris portable snapshot version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "results", "settings"],
  "properties": {
    "formatVersion": {"type": "integer", "const": 1},
    "results": {"type": "array", "maxItems": 10, "items": {"$ref": "#/$defs/result"}},
    "settings": {
      "type": "object", "additionalProperties": false,
      "required": ["ghostVisibility", "hardDropEnabled", "nextPreviewEnabled", "hardDropLockPolicy", "generalLockPolicy", "holdEnabled"],
      "properties": {
        "ghostVisibility": {"type": "string", "enum": ["never", "lower-half", "always"]},
        "hardDropEnabled": {"type": "boolean"},
        "nextPreviewEnabled": {"type": "boolean"},
        "hardDropLockPolicy": {"type": "string", "enum": ["general", "immediate"]},
        "generalLockPolicy": {"type": "string", "enum": ["failed-downward", "gravity-interval"]},
        "holdEnabled": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "result": {
      "type": "object", "additionalProperties": false, "required": ["id", "score", "timestamp"],
      "properties": {
        "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "score": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "timestamp": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"}
      }
    }
  }
}
