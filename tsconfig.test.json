{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022"
    ],
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "outDir": ".test-build",
    "rootDir": ".",
    "allowJs": true
  },
  "include": [
    "src/core",
    "src/application",
    "tests/unit",
    "src/ui/ghost-visibility.ts",
    "src/platform/browser/configuration-codec.ts",
    "src/platform/browser/configuration-persistence.ts",
    "src/platform/browser/file-persistence.ts"
  ]
}
